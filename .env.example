# Signaling server
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# Leave blank when the frontend and signaling server share an origin.
# Example for split hosting: wss://signal.example.com/signal
VITE_SIGNAL_URL=

# Optional managed TURN fallback for restrictive networks.
# Use a credential-scoped Metered API key, not the account secret key.
METERED_TURN_DOMAIN=your-app-name.metered.live
METERED_TURN_API_KEY=your-credential-api-key
