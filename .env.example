# Signaling server
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# Leave blank when the frontend and signaling server share an origin.
# Example for split hosting: wss://signal.example.com/signal
VITE_SIGNAL_URL=

# Optional build-time ICE override. Keep TURN credentials temporary.
# VITE_ICE_SERVERS_JSON=[{"urls":"stun:stun.example.com:3478"}]
